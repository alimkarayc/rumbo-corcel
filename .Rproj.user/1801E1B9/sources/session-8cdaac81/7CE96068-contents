"use strict";

/**
 * API de Rumbo Corcel.
 *
 * Funciones incluidas en esta etapa:
 * - Consultar inventario público.
 * - Crear una reserva interna de 30 minutos.
 * - Liberar automáticamente reservas vencidas.
 *
 * Todavía NO confirma pagos ni envía correos.
 */

const CONFIG = Object.freeze({
  SPREADSHEET_ID: "1AAanWNl5cymlnZVPW7OIOD7Duu17HQNKUYJFxKN-1oM",

  HOJA_PRODUCTOS: "Productos",
  HOJA_PEDIDOS: "Pedidos",
  HOJA_RESERVAS: "Reservas",
  HOJA_CONFIGURACION: "Configuracion",

  ESTADO_PEDIDO_ESPERANDO: "Esperando transferencia",
  ESTADO_PEDIDO_PAGO_INFORMADO: "Pago informado",
  ESTADO_PEDIDO_VENCIDO: "Vencido",

  ESTADO_RESERVA_ACTIVA: "Activa",
  ESTADO_RESERVA_PAGO_INFORMADO: "Pago informado",
  ESTADO_RESERVA_VENCIDA: "Vencida",

  MAX_LINEAS_PEDIDO: 20,
  MAX_UNIDADES_POR_LINEA: 20,

  ORIGEN_PUBLICO: "https://alimkarayc.github.io"
});


/* =========================================================
   APLICACIÓN WEB
   ========================================================= */

/**
 * Solicitudes GET.
 *
 * Ejemplos:
 * ?action=productos
 * ?action=producto&sku=MATE-003
 * ?action=salud
 */
function doGet(e) {
  try {
    const parametros = e && e.parameter
      ? e.parameter
      : {};

    const action = limpiarTexto_(
      parametros.action || "productos"
    ).toLowerCase();

    if (
      action === "productos" ||
      action === "producto"
    ) {
      liberarReservasVencidasSilenciosamente_();
    }

    let respuesta;

    switch (action) {
      case "productos":
        respuesta = obtenerProductosPublicos_();
        break;

      case "producto":
        respuesta = obtenerProductoPorSku_(
          parametros.sku
        );
        break;

      case "salud":
        respuesta = {
          ok: true,
          servicio: "Rumbo Corcel API",
          estado: "operativo",
          fecha: new Date().toISOString()
        };
        break;

      default:
        respuesta = {
          ok: false,
          error: "Acción GET no válida.",
          accionesDisponibles: [
            "productos",
            "producto",
            "salud"
          ]
        };
    }

    return crearRespuesta_(
      respuesta,
      parametros.callback
    );

  } catch (error) {
    console.error(error);

    return crearRespuesta_(
      {
        ok: false,
        error: "No fue posible completar la solicitud.",
        detalle: obtenerMensajeError_(error)
      },
      e && e.parameter
        ? e.parameter.callback
        : ""
    );
  }
}


/**
 * Solicitudes POST.
 *
 * Acción disponible en esta etapa:
 * - crearReserva
 */
function doPost(e) {
  let formato = "json";
  let origenRespuesta = CONFIG.ORIGEN_PUBLICO;

  try {
    const parametros = e && e.parameter
      ? e.parameter
      : {};

    const payload = obtenerPayloadPost_(e);

    formato = limpiarTexto_(
      parametros.formato || payload.formato || "json"
    ).toLowerCase();

    origenRespuesta = obtenerOrigenRespuestaPermitido_(
      parametros.origen || payload.origen
    );

    const action = limpiarTexto_(
      parametros.action || payload.action
    ).toLowerCase();

    let respuesta;

    switch (action) {
      case "crearreserva":
        respuesta = crearReserva_(payload);
        break;

      case "informartransferencia":
        respuesta = informarTransferencia_(payload);
        break;

      default:
        respuesta = {
          ok: false,
          error: "Acción POST no válida.",
          accionesDisponibles: [
            "crearReserva",
            "informarTransferencia"
          ]
        };
    }

    return formato === "iframe"
      ? crearRespuestaIframe_(
          respuesta,
          origenRespuesta
        )
      : crearRespuesta_(respuesta, "");

  } catch (error) {
    console.error(error);

    const respuestaError = {
      ok: false,
      error: obtenerMensajeError_(error)
    };

    return formato === "iframe"
      ? crearRespuestaIframe_(
          respuestaError,
          origenRespuesta
        )
      : crearRespuesta_(respuestaError, "");
  }
}


/* =========================================================
   INVENTARIO PÚBLICO
   ========================================================= */

function obtenerProductosPublicos_() {
  const hoja = obtenerHoja_(
    CONFIG.HOJA_PRODUCTOS
  );

  const datos = hoja.getDataRange().getValues();

  if (datos.length < 2) {
    return {
      ok: true,
      cantidad: 0,
      productos: [],
      actualizado: new Date().toISOString()
    };
  }

  const encabezados = datos[0].map(
    normalizarEncabezado_
  );

  const indices = construirIndices_(encabezados);

  validarColumnas_(
    indices,
    [
      "sku",
      "categoria",
      "producto",
      "precio",
      "disponible",
      "estado",
      "imagen",
      "activo"
    ],
    CONFIG.HOJA_PRODUCTOS
  );

  const productos = datos
    .slice(1)
    .filter((fila) => {
      const sku = limpiarTexto_(
        fila[indices.sku]
      );

      const activo = convertirBooleano_(
        fila[indices.activo]
      );

      return sku !== "" && activo;
    })
    .map((fila) => {
      const disponible = Math.max(
        0,
        convertirNumero_(
          fila[indices.disponible]
        )
      );

      return {
        sku: limpiarTexto_(
          fila[indices.sku]
        ),

        categoria: limpiarTexto_(
          fila[indices.categoria]
        ),

        producto: limpiarTexto_(
          fila[indices.producto]
        ),

        precio: convertirNumero_(
          fila[indices.precio]
        ),

        disponible,

        estado: disponible > 0
          ? "Disponible"
          : "Sin stock",

        imagen: limpiarTexto_(
          fila[indices.imagen]
        )
      };
    });

  return {
    ok: true,
    cantidad: productos.length,
    productos,
    actualizado: new Date().toISOString()
  };
}


function obtenerProductoPorSku_(skuSolicitado) {
  const skuBuscado = limpiarTexto_(
    skuSolicitado
  ).toUpperCase();

  if (!skuBuscado) {
    return {
      ok: false,
      error: "Debes indicar un SKU."
    };
  }

  const respuesta = obtenerProductosPublicos_();

  const producto = respuesta.productos.find(
    (item) =>
      item.sku.toUpperCase() === skuBuscado
  );

  if (!producto) {
    return {
      ok: false,
      error: "Producto no encontrado.",
      sku: skuBuscado
    };
  }

  return {
    ok: true,
    producto
  };
}


/* =========================================================
   CREAR RESERVA DE 30 MINUTOS
   ========================================================= */

function crearReserva_(payload) {
  const lock = LockService.getScriptLock();

  if (!lock.tryLock(20000)) {
    throw new Error(
      "El sistema está procesando otra compra. Intenta nuevamente en unos segundos."
    );
  }

  try {
    liberarReservasVencidasSinLock_();

    const solicitud = validarSolicitudReserva_(payload);
    const configuracion = obtenerConfiguracion_();

    const duracionMinutos = Math.max(
      1,
      Math.floor(
        convertirNumero_(
          configuracion.duracion_reserva_minutos
        ) || 30
      )
    );

    const ahora = new Date();
    const expira = new Date(
      ahora.getTime() +
      duracionMinutos * 60 * 1000
    );

    const inventario = prepararInventarioReserva_(
      solicitud.items
    );

    const subtotal = inventario.items.reduce(
      (total, item) =>
        total + item.precioUnitario * item.cantidad,
      0
    );

    // El envío se calculará en la etapa siguiente.
    const envioEstimado = 0;
    const totalEstimado = subtotal + envioEstimado;

    const idPedidoInterno =
      "PED-" + Utilities.getUuid();

    const filasReserva = inventario.items.map(
      (item) => ({
        idReserva: "RES-" + Utilities.getUuid(),
        idPedido: idPedidoInterno,
        sku: item.sku,
        producto: item.producto,
        cantidad: item.cantidad,
        fechaCreacion: ahora,
        expira,
        estado: CONFIG.ESTADO_RESERVA_ACTIVA,
        precioUnitario: item.precioUnitario,
        fechaCierre: "",
        motivoCierre: "",
        actualizado: ahora
      })
    );

    guardarPedidoYReservas_({
      idPedidoInterno,
      solicitud,
      inventario,
      filasReserva,
      ahora,
      expira,
      subtotal,
      envioEstimado,
      totalEstimado
    });

    SpreadsheetApp.flush();

    return {
      ok: true,
      accion: "crearReserva",
      estado: CONFIG.ESTADO_PEDIDO_ESPERANDO,
      mensaje:
        `Las unidades quedaron reservadas durante ${duracionMinutos} minutos.`,

      // Token técnico interno. No debe mostrarse como código de compra.
      tokenReserva: idPedidoInterno,

      servidorAhora: ahora.toISOString(),
      reservaHasta: expira.toISOString(),
      duracionMinutos,

      items: inventario.items.map(
        (item) => ({
          sku: item.sku,
          producto: item.producto,
          cantidad: item.cantidad,
          precioUnitario: item.precioUnitario,
          totalLinea:
            item.precioUnitario * item.cantidad
        })
      ),

      subtotal,
      envioEstimado,
      totalEstimado,

      transferencia: obtenerDatosTransferencia_(
        configuracion
      )
    };

  } finally {
    lock.releaseLock();
  }
}


function validarSolicitudReserva_(payload) {
  const cliente = payload && payload.cliente
    ? payload.cliente
    : {};

  const nombre = validarTextoObligatorio_(
    cliente.nombre,
    "Nombre",
    120
  );

  const correo = limpiarTexto_(
    cliente.correo
  ).toLowerCase();

  if (
    !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo)
  ) {
    throw new Error(
      "Ingresa un correo electrónico válido."
    );
  }

  const whatsapp = validarTextoObligatorio_(
    cliente.whatsapp,
    "WhatsApp",
    30
  );

  const digitosWhatsapp = whatsapp.replace(/\D/g, "");

  if (
    digitosWhatsapp.length < 8 ||
    digitosWhatsapp.length > 15
  ) {
    throw new Error(
      "Ingresa un número de WhatsApp válido."
    );
  }

  const region = validarTextoObligatorio_(
    cliente.region,
    "Región",
    100
  );

  const comuna = validarTextoObligatorio_(
    cliente.comuna,
    "Comuna",
    100
  );

  const direccion = validarTextoObligatorio_(
    cliente.direccion,
    "Dirección",
    220
  );

  const tipoEntrega = validarTextoObligatorio_(
    cliente.tipoEntrega,
    "Tipo de entrega",
    80
  );

  if (!Array.isArray(payload.items)) {
    throw new Error(
      "El carrito no contiene productos válidos."
    );
  }

  if (
    payload.items.length < 1 ||
    payload.items.length > CONFIG.MAX_LINEAS_PEDIDO
  ) {
    throw new Error(
      "La cantidad de productos del carrito no es válida."
    );
  }

  const cantidadesPorSku = {};

  payload.items.forEach((item) => {
    const sku = limpiarTexto_(
      item && item.sku
    ).toUpperCase();

    const cantidad = Math.floor(
      convertirNumero_(
        item && item.cantidad
      )
    );

    if (!sku) {
      throw new Error(
        "Uno de los productos no tiene SKU."
      );
    }

    if (
      cantidad < 1 ||
      cantidad > CONFIG.MAX_UNIDADES_POR_LINEA
    ) {
      throw new Error(
        `La cantidad solicitada para ${sku} no es válida.`
      );
    }

    cantidadesPorSku[sku] =
      (cantidadesPorSku[sku] || 0) + cantidad;

    if (
      cantidadesPorSku[sku] >
      CONFIG.MAX_UNIDADES_POR_LINEA
    ) {
      throw new Error(
        `La cantidad total solicitada para ${sku} supera el máximo permitido.`
      );
    }
  });

  const items = Object.keys(
    cantidadesPorSku
  ).map((sku) => ({
    sku,
    cantidad: cantidadesPorSku[sku]
  }));

  return {
    cliente: {
      nombre,
      correo,
      whatsapp,
      region,
      comuna,
      direccion,
      tipoEntrega
    },
    items
  };
}


function prepararInventarioReserva_(itemsSolicitados) {
  const hoja = obtenerHoja_(
    CONFIG.HOJA_PRODUCTOS
  );

  const datos = hoja.getDataRange().getValues();

  if (datos.length < 2) {
    throw new Error(
      "No hay productos disponibles."
    );
  }

  const encabezados = datos[0].map(
    normalizarEncabezado_
  );

  const indices = construirIndices_(encabezados);

  validarColumnas_(
    indices,
    [
      "sku",
      "producto",
      "precio",
      "stockfisico",
      "reservado",
      "disponible",
      "estado",
      "activo",
      "actualizado"
    ],
    CONFIG.HOJA_PRODUCTOS
  );

  const productosPorSku = {};

  datos.slice(1).forEach((fila, indiceRelativo) => {
    const sku = limpiarTexto_(
      fila[indices.sku]
    ).toUpperCase();

    if (!sku) {
      return;
    }

    productosPorSku[sku] = {
      fila,
      numeroFila: indiceRelativo + 2
    };
  });

  const items = itemsSolicitados.map(
    (solicitado) => {
      const encontrado = productosPorSku[
        solicitado.sku
      ];

      if (!encontrado) {
        throw new Error(
          `El producto ${solicitado.sku} ya no existe.`
        );
      }

      const activo = convertirBooleano_(
        encontrado.fila[indices.activo]
      );

      if (!activo) {
        throw new Error(
          `El producto ${solicitado.sku} no está disponible.`
        );
      }

      const stockFisico = Math.max(
        0,
        convertirNumero_(
          encontrado.fila[indices.stockfisico]
        )
      );

      const reservadoActual = Math.max(
        0,
        convertirNumero_(
          encontrado.fila[indices.reservado]
        )
      );

      const disponibleReal = Math.max(
        0,
        stockFisico - reservadoActual
      );

      if (solicitado.cantidad > disponibleReal) {
        throw new Error(
          disponibleReal === 0
            ? `El producto ${solicitado.sku} acaba de quedar sin stock.`
            : `Solo quedan ${disponibleReal} unidades disponibles de ${solicitado.sku}.`
        );
      }

      return {
        sku: solicitado.sku,
        producto: limpiarTexto_(
          encontrado.fila[indices.producto]
        ),
        cantidad: solicitado.cantidad,
        precioUnitario: Math.max(
          0,
          convertirNumero_(
            encontrado.fila[indices.precio]
          )
        ),
        stockFisico,
        reservadoActual,
        reservadoNuevo:
          reservadoActual + solicitado.cantidad,
        numeroFila: encontrado.numeroFila
      };
    }
  );

  return {
    hoja,
    indices,
    items
  };
}


function guardarPedidoYReservas_(datosReserva) {
  const hojaPedidos = obtenerHoja_(
    CONFIG.HOJA_PEDIDOS
  );

  const hojaReservas = obtenerHoja_(
    CONFIG.HOJA_RESERVAS
  );

  const encabezadosPedidos = obtenerEncabezadosHoja_(
    hojaPedidos
  );

  const indicesPedidos = construirIndices_(
    encabezadosPedidos.normalizados
  );

  validarColumnas_(
    indicesPedidos,
    [
      "idpedido",
      "fecha",
      "nombre",
      "whatsapp",
      "correo",
      "region",
      "comuna",
      "direccion",
      "tipoentrega",
      "items",
      "subtotal",
      "envioestimado",
      "totalestimado",
      "estado",
      "reservahasta",
      "observaciones",
      "pagoinformado",
      "fechapagoinformado",
      "titulartransferencia",
      "montotransferenciainformado",
      "revisarantesde",
      "actualizado"
    ],
    CONFIG.HOJA_PEDIDOS
  );

  const encabezadosReservas = obtenerEncabezadosHoja_(
    hojaReservas
  );

  const indicesReservas = construirIndices_(
    encabezadosReservas.normalizados
  );

  validarColumnas_(
    indicesReservas,
    [
      "idreserva",
      "idpedido",
      "sku",
      "producto",
      "cantidad",
      "fechacreacion",
      "expira",
      "estado",
      "preciounitario",
      "fechacierre",
      "motivocierre",
      "actualizado"
    ],
    CONFIG.HOJA_RESERVAS
  );

  const cliente = datosReserva.solicitud.cliente;

  const itemsPedido = datosReserva.inventario.items.map(
    (item) => ({
      sku: item.sku,
      producto: item.producto,
      cantidad: item.cantidad,
      precioUnitario: item.precioUnitario,
      totalLinea:
        item.precioUnitario * item.cantidad
    })
  );

  const filaPedido = crearFilaSegunEncabezados_(
    encabezadosPedidos.normalizados,
    {
      idpedido: datosReserva.idPedidoInterno,
      fecha: datosReserva.ahora,
      nombre: cliente.nombre,
      whatsapp: cliente.whatsapp,
      correo: cliente.correo,
      region: cliente.region,
      comuna: cliente.comuna,
      direccion: cliente.direccion,
      tipoentrega: cliente.tipoEntrega,
      items: JSON.stringify(itemsPedido),
      subtotal: datosReserva.subtotal,
      envioestimado: datosReserva.envioEstimado,
      totalestimado: datosReserva.totalEstimado,
      estado: CONFIG.ESTADO_PEDIDO_ESPERANDO,
      reservahasta: datosReserva.expira,
      linkpago: "",
      observaciones: "Reserva interna de 30 minutos.",
      pagoinformado: false,
      actualizado: datosReserva.ahora
    }
  );

  const filasReservas = datosReserva.filasReserva.map(
    (reserva) =>
      crearFilaSegunEncabezados_(
        encabezadosReservas.normalizados,
        {
          idreserva: reserva.idReserva,
          idpedido: reserva.idPedido,
          sku: reserva.sku,
          producto: reserva.producto,
          cantidad: reserva.cantidad,
          fechacreacion: reserva.fechaCreacion,
          expira: reserva.expira,
          estado: reserva.estado,
          preciounitario: reserva.precioUnitario,
          fechacierre: reserva.fechaCierre,
          motivocierre: reserva.motivoCierre,
          actualizado: reserva.actualizado
        }
      )
  );

  const filaPedidoDestino = hojaPedidos.getLastRow() + 1;
  const filaReservaDestino = hojaReservas.getLastRow() + 1;

  hojaPedidos
    .getRange(
      filaPedidoDestino,
      1,
      1,
      filaPedido.length
    )
    .setValues([filaPedido]);

  hojaReservas
    .getRange(
      filaReservaDestino,
      1,
      filasReservas.length,
      filasReservas[0].length
    )
    .setValues(filasReservas);

  datosReserva.inventario.items.forEach(
    (item) => {
      actualizarProductoReservado_(
        datosReserva.inventario.hoja,
        datosReserva.inventario.indices,
        item.numeroFila,
        item.stockFisico,
        item.reservadoNuevo,
        datosReserva.ahora
      );
    }
  );
}


function actualizarProductoReservado_(
  hoja,
  indices,
  numeroFila,
  stockFisico,
  reservadoNuevo,
  fecha
) {
  hoja.getRange(
    numeroFila,
    indices.reservado + 1
  ).setValue(reservadoNuevo);

  const disponibleNuevo = Math.max(
    0,
    stockFisico - reservadoNuevo
  );

  escribirSiNoTieneFormula_(
    hoja,
    numeroFila,
    indices.disponible + 1,
    disponibleNuevo
  );

  escribirSiNoTieneFormula_(
    hoja,
    numeroFila,
    indices.estado + 1,
    disponibleNuevo > 0
      ? "Disponible"
      : "Sin stock"
  );

  hoja.getRange(
    numeroFila,
    indices.actualizado + 1
  ).setValue(fecha);
}



/* =========================================================
   INFORMAR TRANSFERENCIA
   ========================================================= */

function informarTransferencia_(payload) {
  const lock = LockService.getScriptLock();

  if (!lock.tryLock(20000)) {
    throw new Error(
      "El sistema está procesando otra solicitud. Intenta nuevamente en unos segundos."
    );
  }

  try {
    const tokenReserva = validarTextoObligatorio_(
      payload && payload.tokenReserva,
      "reserva",
      100
    );

    const titularTransferencia = validarTextoObligatorio_(
      payload && payload.titularTransferencia,
      "titular de la transferencia",
      120
    );

    const hojaPedidos = obtenerHoja_(
      CONFIG.HOJA_PEDIDOS
    );

    const hojaReservas = obtenerHoja_(
      CONFIG.HOJA_RESERVAS
    );

    const datosPedidos = hojaPedidos
      .getDataRange()
      .getValues();

    const encabezadosPedidos = datosPedidos[0].map(
      normalizarEncabezado_
    );

    const indicesPedidos = construirIndices_(
      encabezadosPedidos
    );

    validarColumnas_(
      indicesPedidos,
      [
        "idpedido",
        "estado",
        "reservahasta",
        "totalestimado",
        "pagoinformado",
        "fechapagoinformado",
        "titulartransferencia",
        "montotransferenciainformado",
        "revisarantesde",
        "actualizado"
      ],
      CONFIG.HOJA_PEDIDOS
    );

    let pedidoEncontrado = null;

    datosPedidos.slice(1).some(
      (fila, indiceRelativo) => {
        const idPedido = limpiarTexto_(
          fila[indicesPedidos.idpedido]
        );

        if (idPedido !== tokenReserva) {
          return false;
        }

        pedidoEncontrado = {
          fila,
          numeroFila: indiceRelativo + 2
        };

        return true;
      }
    );

    if (!pedidoEncontrado) {
      throw new Error(
        "No encontramos la reserva. Vuelve al catálogo e inténtalo nuevamente."
      );
    }

    const estadoActual = limpiarTexto_(
      pedidoEncontrado.fila[
        indicesPedidos.estado
      ]
    );

    if (
      estadoActual.toLowerCase() ===
      CONFIG.ESTADO_PEDIDO_PAGO_INFORMADO.toLowerCase()
    ) {
      const revisarAntesExistente = convertirFecha_(
        pedidoEncontrado.fila[
          indicesPedidos.revisarantesde
        ]
      );

      return {
        ok: true,
        accion: "informarTransferencia",
        estado: CONFIG.ESTADO_PEDIDO_PAGO_INFORMADO,
        mensaje:
          "La transferencia ya había sido informada.",
        revisarAntesDe: revisarAntesExistente
          ? revisarAntesExistente.toISOString()
          : "",
        plazoMaximoHoras: 12
      };
    }

    if (
      estadoActual.toLowerCase() !==
      CONFIG.ESTADO_PEDIDO_ESPERANDO.toLowerCase()
    ) {
      return {
        ok: false,
        accion: "informarTransferencia",
        reservaVencida:
          estadoActual.toLowerCase() ===
          CONFIG.ESTADO_PEDIDO_VENCIDO.toLowerCase(),
        error:
          estadoActual.toLowerCase() ===
          CONFIG.ESTADO_PEDIDO_VENCIDO.toLowerCase()
            ? "La reserva ya venció y las unidades fueron liberadas."
            : "Esta reserva ya no puede marcarse como transferencia informada."
      };
    }

    const ahora = new Date();

    const reservaHasta = convertirFecha_(
      pedidoEncontrado.fila[
        indicesPedidos.reservahasta
      ]
    );

    if (
      !reservaHasta ||
      reservaHasta.getTime() <= ahora.getTime()
    ) {
      liberarReservasVencidasSinLock_();
      SpreadsheetApp.flush();

      return {
        ok: false,
        accion: "informarTransferencia",
        reservaVencida: true,
        error:
          "Han pasado más de 30 minutos. Las unidades fueron liberadas y debes iniciar nuevamente la compra."
      };
    }

    const configuracion = obtenerConfiguracion_();

    const plazoMaximoHoras = Math.max(
      1,
      Math.floor(
        convertirNumero_(
          configuracion.plazo_maximo_confirmacion_pago_horas
        ) || 12
      )
    );

    const revisarAntesDe = new Date(
      ahora.getTime() +
      plazoMaximoHoras * 60 * 60 * 1000
    );

    const totalEstimado = Math.max(
      0,
      convertirNumero_(
        pedidoEncontrado.fila[
          indicesPedidos.totalestimado
        ]
      )
    );

    const escribirPedido = (
      nombreIndice,
      valor
    ) => {
      hojaPedidos.getRange(
        pedidoEncontrado.numeroFila,
        indicesPedidos[nombreIndice] + 1
      ).setValue(valor);
    };

    escribirPedido(
      "estado",
      CONFIG.ESTADO_PEDIDO_PAGO_INFORMADO
    );

    escribirPedido("pagoinformado", true);
    escribirPedido("fechapagoinformado", ahora);

    escribirPedido(
      "titulartransferencia",
      titularTransferencia
    );

    escribirPedido(
      "montotransferenciainformado",
      totalEstimado
    );

    escribirPedido(
      "revisarantesde",
      revisarAntesDe
    );

    escribirPedido("actualizado", ahora);

    const datosReservas = hojaReservas
      .getDataRange()
      .getValues();

    const encabezadosReservas = datosReservas[0].map(
      normalizarEncabezado_
    );

    const indicesReservas = construirIndices_(
      encabezadosReservas
    );

    validarColumnas_(
      indicesReservas,
      [
        "idpedido",
        "estado",
        "actualizado"
      ],
      CONFIG.HOJA_RESERVAS
    );

    datosReservas.slice(1).forEach(
      (fila, indiceRelativo) => {
        const idPedido = limpiarTexto_(
          fila[indicesReservas.idpedido]
        );

        const estadoReserva = limpiarTexto_(
          fila[indicesReservas.estado]
        );

        if (
          idPedido !== tokenReserva ||
          estadoReserva.toLowerCase() !==
            CONFIG.ESTADO_RESERVA_ACTIVA.toLowerCase()
        ) {
          return;
        }

        const numeroFila = indiceRelativo + 2;

        hojaReservas.getRange(
          numeroFila,
          indicesReservas.estado + 1
        ).setValue(
          CONFIG.ESTADO_RESERVA_PAGO_INFORMADO
        );

        hojaReservas.getRange(
          numeroFila,
          indicesReservas.actualizado + 1
        ).setValue(ahora);
      }
    );

    SpreadsheetApp.flush();

    return {
      ok: true,
      accion: "informarTransferencia",
      estado: CONFIG.ESTADO_PEDIDO_PAGO_INFORMADO,
      mensaje:
        "Estamos verificando el depósito. Tu compra todavía no está confirmada.",
      revisarAntesDe: revisarAntesDe.toISOString(),
      plazoMaximoHoras
    };

  } finally {
    lock.releaseLock();
  }
}


/* =========================================================
   LIBERAR RESERVAS VENCIDAS
   ========================================================= */

/**
 * Función pública para el activador horario.
 */
function liberarReservasVencidas() {
  const lock = LockService.getScriptLock();

  if (!lock.tryLock(20000)) {
    return;
  }

  try {
    const resultado = liberarReservasVencidasSinLock_();
    SpreadsheetApp.flush();
    console.log(JSON.stringify(resultado));
  } finally {
    lock.releaseLock();
  }
}


function liberarReservasVencidasSilenciosamente_() {
  const lock = LockService.getScriptLock();

  if (!lock.tryLock(3000)) {
    return;
  }

  try {
    liberarReservasVencidasSinLock_();
    SpreadsheetApp.flush();
  } catch (error) {
    console.error(error);
  } finally {
    lock.releaseLock();
  }
}


function liberarReservasVencidasSinLock_() {
  const hojaReservas = obtenerHoja_(
    CONFIG.HOJA_RESERVAS
  );

  const hojaPedidos = obtenerHoja_(
    CONFIG.HOJA_PEDIDOS
  );

  const hojaProductos = obtenerHoja_(
    CONFIG.HOJA_PRODUCTOS
  );

  const datosReservas = hojaReservas
    .getDataRange()
    .getValues();

  if (datosReservas.length < 2) {
    return {
      liberadas: 0,
      pedidosVencidos: 0
    };
  }

  const encabezadosReservas = datosReservas[0].map(
    normalizarEncabezado_
  );

  const indicesReservas = construirIndices_(
    encabezadosReservas
  );

  validarColumnas_(
    indicesReservas,
    [
      "idpedido",
      "sku",
      "cantidad",
      "expira",
      "estado",
      "fechacierre",
      "motivocierre",
      "actualizado"
    ],
    CONFIG.HOJA_RESERVAS
  );

  const datosPedidos = hojaPedidos
    .getDataRange()
    .getValues();

  const encabezadosPedidos = datosPedidos[0].map(
    normalizarEncabezado_
  );

  const indicesPedidos = construirIndices_(
    encabezadosPedidos
  );

  validarColumnas_(
    indicesPedidos,
    [
      "idpedido",
      "estado",
      "actualizado"
    ],
    CONFIG.HOJA_PEDIDOS
  );

  const pedidosPorId = {};

  datosPedidos.slice(1).forEach(
    (fila, indiceRelativo) => {
      const idPedido = limpiarTexto_(
        fila[indicesPedidos.idpedido]
      );

      if (!idPedido) {
        return;
      }

      pedidosPorId[idPedido] = {
        fila,
        numeroFila: indiceRelativo + 2
      };
    }
  );

  const datosProductos = hojaProductos
    .getDataRange()
    .getValues();

  const encabezadosProductos = datosProductos[0].map(
    normalizarEncabezado_
  );

  const indicesProductos = construirIndices_(
    encabezadosProductos
  );

  validarColumnas_(
    indicesProductos,
    [
      "sku",
      "stockfisico",
      "reservado",
      "disponible",
      "estado",
      "actualizado"
    ],
    CONFIG.HOJA_PRODUCTOS
  );

  const productosPorSku = {};

  datosProductos.slice(1).forEach(
    (fila, indiceRelativo) => {
      const sku = limpiarTexto_(
        fila[indicesProductos.sku]
      ).toUpperCase();

      if (!sku) {
        return;
      }

      productosPorSku[sku] = {
        fila,
        numeroFila: indiceRelativo + 2
      };
    }
  );

  const ahora = new Date();
  const cantidadesALiberar = {};
  const pedidosVencidos = {};
  let reservasLiberadas = 0;

  datosReservas.slice(1).forEach(
    (fila, indiceRelativo) => {
      const estadoReserva = limpiarTexto_(
        fila[indicesReservas.estado]
      ).toLowerCase();

      if (
        estadoReserva !==
        CONFIG.ESTADO_RESERVA_ACTIVA.toLowerCase()
      ) {
        return;
      }

      const expira = convertirFecha_(
        fila[indicesReservas.expira]
      );

      if (!expira || expira.getTime() > ahora.getTime()) {
        return;
      }

      const idPedido = limpiarTexto_(
        fila[indicesReservas.idpedido]
      );

      const pedido = pedidosPorId[idPedido];

      if (!pedido) {
        return;
      }

      const estadoPedido = limpiarTexto_(
        pedido.fila[indicesPedidos.estado]
      ).toLowerCase();

      if (
        estadoPedido !==
        CONFIG.ESTADO_PEDIDO_ESPERANDO.toLowerCase()
      ) {
        return;
      }

      const sku = limpiarTexto_(
        fila[indicesReservas.sku]
      ).toUpperCase();

      const cantidad = Math.max(
        0,
        convertirNumero_(
          fila[indicesReservas.cantidad]
        )
      );

      cantidadesALiberar[sku] =
        (cantidadesALiberar[sku] || 0) + cantidad;

      pedidosVencidos[idPedido] = pedido;

      const numeroFilaReserva = indiceRelativo + 2;

      hojaReservas.getRange(
        numeroFilaReserva,
        indicesReservas.estado + 1
      ).setValue(CONFIG.ESTADO_RESERVA_VENCIDA);

      hojaReservas.getRange(
        numeroFilaReserva,
        indicesReservas.fechacierre + 1
      ).setValue(ahora);

      hojaReservas.getRange(
        numeroFilaReserva,
        indicesReservas.motivocierre + 1
      ).setValue(
        "Pasaron 30 minutos sin informar la transferencia."
      );

      hojaReservas.getRange(
        numeroFilaReserva,
        indicesReservas.actualizado + 1
      ).setValue(ahora);

      reservasLiberadas += 1;
    }
  );

  Object.keys(cantidadesALiberar).forEach(
    (sku) => {
      const producto = productosPorSku[sku];

      if (!producto) {
        return;
      }

      const stockFisico = Math.max(
        0,
        convertirNumero_(
          producto.fila[indicesProductos.stockfisico]
        )
      );

      const reservadoActual = Math.max(
        0,
        convertirNumero_(
          producto.fila[indicesProductos.reservado]
        )
      );

      const reservadoNuevo = Math.max(
        0,
        reservadoActual - cantidadesALiberar[sku]
      );

      actualizarProductoReservado_(
        hojaProductos,
        indicesProductos,
        producto.numeroFila,
        stockFisico,
        reservadoNuevo,
        ahora
      );
    }
  );

  Object.keys(pedidosVencidos).forEach(
    (idPedido) => {
      const pedido = pedidosVencidos[idPedido];

      hojaPedidos.getRange(
        pedido.numeroFila,
        indicesPedidos.estado + 1
      ).setValue(CONFIG.ESTADO_PEDIDO_VENCIDO);

      hojaPedidos.getRange(
        pedido.numeroFila,
        indicesPedidos.actualizado + 1
      ).setValue(ahora);
    }
  );

  return {
    liberadas: reservasLiberadas,
    pedidosVencidos:
      Object.keys(pedidosVencidos).length
  };
}


/**
 * Ejecutar una sola vez desde el editor.
 * Crea un activador que revisa cada 1 minuto.
 */
function instalarTriggerReservas() {
  const nombreFuncion =
    "liberarReservasVencidas";

  ScriptApp.getProjectTriggers()
    .filter(
      (trigger) =>
        trigger.getHandlerFunction() ===
        nombreFuncion
    )
    .forEach(
      (trigger) =>
        ScriptApp.deleteTrigger(trigger)
    );

  ScriptApp.newTrigger(nombreFuncion)
    .timeBased()
    .everyMinutes(1)
    .create();

  console.log(
    "Trigger de reservas instalado correctamente."
  );
}


