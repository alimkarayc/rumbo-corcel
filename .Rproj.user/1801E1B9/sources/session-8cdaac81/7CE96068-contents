function crearRespuesta_(datos, callback) {
  const json = JSON.stringify(datos);

  const nombreCallback = limpiarTexto_(
    callback
  );

  if (
    nombreCallback &&
    /^[a-zA-Z_$][a-zA-Z0-9_$]*$/.test(
      nombreCallback
    )
  ) {
    return ContentService
      .createTextOutput(
        `${nombreCallback}(${json});`
      )
      .setMimeType(
        ContentService.MimeType.JAVASCRIPT
      );
  }

  return ContentService
    .createTextOutput(json)
    .setMimeType(
      ContentService.MimeType.JSON
    );
}


function crearRespuestaIframe_(
  datos,
  origenRespuesta
) {
  const mensaje = Object.assign(
    {
      tipo: "rumbo-reserva-respuesta"
    },
    datos
  );

  const jsonSeguro = JSON.stringify(
    mensaje
  )
    .replace(/</g, "\u003c")
    .replace(/>/g, "\u003e")
    .replace(/&/g, "\u0026");

  return HtmlService
    .createHtmlOutput(
      `<!doctype html>
      <html>
        <head>
          <meta charset="utf-8">
        </head>

        <body>
          <script>
            (function () {
              const mensaje = ${jsonSeguro};

              window.top.postMessage(
                mensaje,
                "*"
              );
            })();
          <\/script>
        </body>
      </html>`
    )
    .setXFrameOptionsMode(
      HtmlService.XFrameOptionsMode.ALLOWALL
    );
}


function obtenerPayloadPost_(e) {
  const parametros = e && e.parameter
    ? e.parameter
    : {};

  if (parametros.payload) {
    try {
      return JSON.parse(parametros.payload);
    } catch (error) {
      throw new Error(
        "El contenido enviado no tiene un formato válido."
      );
    }
  }

  const contenido = e && e.postData
    ? limpiarTexto_(e.postData.contents)
    : "";

  if (!contenido) {
    return parametros;
  }

  const tipo = e.postData && e.postData.type
    ? limpiarTexto_(e.postData.type).toLowerCase()
    : "";

  if (tipo.indexOf("application/json") !== -1) {
    try {
      return JSON.parse(contenido);
    } catch (error) {
      throw new Error(
        "El JSON enviado no es válido."
      );
    }
  }

  return parametros;
}


function obtenerOrigenRespuestaPermitido_(origen) {
  const valor = limpiarTexto_(origen);

  if (
    valor === "https://alimkarayc.github.io" ||
    /^http:\/\/localhost:\d+$/.test(valor) ||
    /^http:\/\/127\.0\.0\.1:\d+$/.test(valor)
  ) {
    return valor;
  }

  return CONFIG.ORIGEN_PUBLICO;
}


/* =========================================================
   UTILIDADES GENERALES
   ========================================================= */

function normalizarEncabezado_(valor) {
  return limpiarTexto_(valor)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-zA-Z0-9]/g, "")
    .toLowerCase();
}


function convertirNumero_(valor) {
  if (typeof valor === "number") {
    return Number.isFinite(valor)
      ? valor
      : 0;
  }

  const limpio = String(valor || "")
    .replace(/\$/g, "")
    .replace(/\./g, "")
    .replace(/,/g, ".")
    .replace(/\s/g, "");

  const numero = Number(limpio);

  return Number.isFinite(numero)
    ? numero
    : 0;
}


function convertirBooleano_(valor) {
  if (valor === true) {
    return true;
  }

  const texto = limpiarTexto_(valor)
    .toLowerCase();

  return [
    "true",
    "verdadero",
    "si",
    "sí",
    "1"
  ].includes(texto);
}


function convertirFecha_(valor) {
  if (valor instanceof Date) {
    return Number.isNaN(valor.getTime())
      ? null
      : valor;
  }

  const fecha = new Date(valor);

  return Number.isNaN(fecha.getTime())
    ? null
    : fecha;
}


function validarTextoObligatorio_(
  valor,
  nombreCampo,
  largoMaximo
) {
  const texto = limpiarTexto_(valor);

  if (!texto) {
    throw new Error(
      `Completa el campo ${nombreCampo}.`
    );
  }

  if (texto.length > largoMaximo) {
    throw new Error(
      `El campo ${nombreCampo} es demasiado largo.`
    );
  }

  return texto;
}


function limpiarTexto_(valor) {
  return String(
    valor === null || valor === undefined
      ? ""
      : valor
  ).trim();
}


function obtenerMensajeError_(error) {
  return String(
    error && error.message
      ? error.message
      : error
  );
}


