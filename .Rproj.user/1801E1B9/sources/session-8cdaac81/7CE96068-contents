/* =========================================================
   UTILIDADES DE HOJAS
   ========================================================= */

function obtenerHoja_(nombreHoja) {
  const archivo = SpreadsheetApp.openById(
    CONFIG.SPREADSHEET_ID
  );

  const hoja = archivo.getSheetByName(
    nombreHoja
  );

  if (!hoja) {
    throw new Error(
      `No existe la hoja "${nombreHoja}".`
    );
  }

  return hoja;
}


function obtenerEncabezadosHoja_(hoja) {
  const ultimaColumna = hoja.getLastColumn();

  if (ultimaColumna < 1) {
    throw new Error(
      `La hoja "${hoja.getName()}" no tiene encabezados.`
    );
  }

  const originales = hoja
    .getRange(1, 1, 1, ultimaColumna)
    .getValues()[0];

  return {
    originales,
    normalizados: originales.map(
      normalizarEncabezado_
    )
  };
}


function construirIndices_(encabezados) {
  return encabezados.reduce(
    (resultado, encabezado, indice) => {
      resultado[encabezado] = indice;
      return resultado;
    },
    {}
  );
}


function validarColumnas_(
  indices,
  requeridas,
  nombreHoja
) {
  const faltantes = requeridas.filter(
    (columna) =>
      indices[columna] === undefined
  );

  if (faltantes.length > 0) {
    throw new Error(
      `Faltan columnas en ${nombreHoja}: ` +
      faltantes.join(", ")
    );
  }
}


function crearFilaSegunEncabezados_(
  encabezadosNormalizados,
  valores
) {
  return encabezadosNormalizados.map(
    (encabezado) =>
      Object.prototype.hasOwnProperty.call(
        valores,
        encabezado
      )
        ? valores[encabezado]
        : ""
  );
}


function escribirSiNoTieneFormula_(
  hoja,
  fila,
  columna,
  valor
) {
  const celda = hoja.getRange(
    fila,
    columna
  );

  if (!celda.getFormula()) {
    celda.setValue(valor);
  }
}


