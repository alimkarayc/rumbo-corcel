construir_ventana <- function(evento, base, pre = 15, post = 60) {
fecha_centro <- evento$fecha
zona_evento <- evento$zona
id_evento <- evento$id_evento_fuerte
base %>%
filter(
zona == zona_evento,
fecha >= fecha_centro - pre,
fecha <= fecha_centro + post
) %>%
mutate(
id_evento_fuerte = id_evento,
fecha_evento_fuerte = fecha_centro,
dia_relativo = as.integer(fecha - fecha_centro)
) %>%
count(
id_evento_fuerte,
zona,
fecha_evento_fuerte,
dia_relativo,
name = "n_eventos"
)
}
ventanas_lista <- lapply(
split(eventos_centrales, eventos_centrales$id_evento_fuerte),
construir_ventana,
base = base_fda,
pre = ventana_pre,
post = ventana_post
)
ventanas_crudas <- bind_rows(ventanas_lista)
#aquí completamos los días sin eventos con cero lol
grilla_dias <- data.frame(
dia_relativo = seq(-ventana_pre, ventana_post, by = 1)
)
ventanas_completas <- eventos_centrales %>%
select(id_evento_fuerte, zona, fecha_evento_fuerte = fecha) %>%
crossing(grilla_dias) %>%
left_join(
ventanas_crudas,
by = c("id_evento_fuerte", "zona", "fecha_evento_fuerte", "dia_relativo")
) %>%
mutate(
n_eventos = ifelse(is.na(n_eventos), 0, n_eventos)
)
ventanas_completas %>%
count(id_evento_fuerte) %>%
summarise(
min_dias = min(n),
max_dias = max(n)
)
#establecemos el min
min_dias = 76
max_dias = 76
#gráficoooo--------
ggplot(ventanas_completas, aes(x = dia_relativo, y = n_eventos, group = id_evento_fuerte)) +
geom_line(alpha = 0.20) +
geom_vline(xintercept = 0, linetype = "dashed") +
facet_wrap(~ zona, scales = "free_y") +
labs(
title = "Trayectorias diarias de actividad sísmica alrededor de eventos fuertes",
subtitle = "Eventos centrales Mw_hom ≥ 6,0; ventana [-15, +60] días",
x = "Días relativos al evento fuerte",
y = "Número diario de eventos"
) +
theme_minimal()
#1.-vamos con el evento que genera el peak gigante en chile------
ventanas_completas %>%
group_by(id_evento_fuerte, zona) %>%
summarise(
max_diario = max(n_eventos, na.rm = TRUE),
dia_max = dia_relativo[which.max(n_eventos)],
total_ventana = sum(n_eventos, na.rm = TRUE),
.groups = "drop"
) %>%
arrange(desc(max_diario)) %>%
head(10)
eventos_centrales %>%
select(id_evento_fuerte, zona, fecha, Mw_hom, latitude, longitude, depth) %>%
left_join(
ventanas_completas %>%
group_by(id_evento_fuerte, zona) %>%
summarise(
max_diario = max(n_eventos, na.rm = TRUE),
total_ventana = sum(n_eventos, na.rm = TRUE),
.groups = "drop"
),
by = c("id_evento_fuerte", "zona")
) %>%
arrange(desc(max_diario)) %>%
head(10)
#2-hacemos una curva media por zona, mediana e intervalo intercuartilico
curvas_resumen <- ventanas_completas %>%
group_by(zona, dia_relativo) %>%
summarise(
media = mean(n_eventos, na.rm = TRUE),
mediana = median(n_eventos, na.rm = TRUE),
q25 = quantile(n_eventos, 0.25, na.rm = TRUE),
q75 = quantile(n_eventos, 0.75, na.rm = TRUE),
q90 = quantile(n_eventos, 0.90, na.rm = TRUE),
.groups = "drop"
)
ggplot(curvas_resumen, aes(x = dia_relativo, y = mediana, color = zona, fill = zona)) +
geom_ribbon(aes(ymin = q25, ymax = q75), alpha = 0.20, color = NA) +
geom_line(linewidth = 1) +
geom_vline(xintercept = 0, linetype = "dashed") +
labs(
title = "Curva funcional mediana de actividad sísmica alrededor de eventos fuertes",
subtitle = "Eventos centrales Mw_hom ≥ 6,0; ventana [-15, +60] días",
x = "Días relativos al evento fuerte",
y = "Número diario mediano de eventos",
color = "Zona",
fill = "Zona"
) +
theme_minimal()
##versión de escala logarítmica log(1+n)
ventanas_log <- ventanas_completas %>%
mutate(log_eventos = log1p(n_eventos))
curvas_log <- ventanas_log %>%
group_by(zona, dia_relativo) %>%
summarise(
media_log = mean(log_eventos, na.rm = TRUE),
mediana_log = median(log_eventos, na.rm = TRUE),
q25_log = quantile(log_eventos, 0.25, na.rm = TRUE),
q75_log = quantile(log_eventos, 0.75, na.rm = TRUE),
.groups = "drop"
)
ggplot(curvas_log, aes(x = dia_relativo, y = media_log, color = zona, fill = zona)) +
geom_ribbon(aes(ymin = q25_log, ymax = q75_log), alpha = 0.20, color = NA) +
geom_line(linewidth = 1) +
geom_vline(xintercept = 0, linetype = "dashed") +
labs(
title = "Curva media funcional de actividad sísmica en escala logarítmica",
subtitle = "Transformación log(1+n) para reducir influencia de secuencias extremas",
x = "Días relativos al evento fuerte",
y = "log(1 + número diario de eventos)",
color = "Zona",
fill = "Zona"
) +
theme_minimal()
#ahora transformamos cada curva en indicadores simpless
indicadores_funcionales <- ventanas_completas %>%
filter(dia_relativo >= 0) %>%
group_by(id_evento_fuerte, zona) %>%
summarise(
area_post = sum(n_eventos, na.rm = TRUE),
max_tasa_post = max(n_eventos, na.rm = TRUE),
dia_max_tasa = dia_relativo[which.max(n_eventos)],
actividad_0_7 = sum(n_eventos[dia_relativo >= 0 & dia_relativo <= 7], na.rm = TRUE),
actividad_8_30 = sum(n_eventos[dia_relativo >= 8 & dia_relativo <= 30], na.rm = TRUE),
actividad_31_60 = sum(n_eventos[dia_relativo >= 31 & dia_relativo <= 60], na.rm = TRUE),
proporcion_0_7 = actividad_0_7 / area_post,
.groups = "drop"
)
indicadores_funcionales <- ventanas_completas %>%
filter(dia_relativo >= 0) %>%
group_by(id_evento_fuerte, zona) %>%
summarise(
area_post = sum(n_eventos, na.rm = TRUE),
max_tasa_post = max(n_eventos, na.rm = TRUE),
dia_max_tasa = dia_relativo[which.max(n_eventos)],
actividad_0_7 = sum(n_eventos[dia_relativo >= 0 & dia_relativo <= 7], na.rm = TRUE),
actividad_8_30 = sum(n_eventos[dia_relativo >= 8 & dia_relativo <= 30], na.rm = TRUE),
actividad_31_60 = sum(n_eventos[dia_relativo >= 31 & dia_relativo <= 60], na.rm = TRUE),
proporcion_0_7 = actividad_0_7 / area_post,
.groups = "drop"
)
#aquí conecté DFunc con NPara
wilcox.test(area_post ~ zona, data = indicadores_funcionales)
wilcox.test(max_tasa_post ~ zona, data = indicadores_funcionales)
wilcox.test(actividad_0_7 ~ zona, data = indicadores_funcionales)
wilcox.test(actividad_8_30 ~ zona, data = indicadores_funcionales)
wilcox.test(actividad_31_60 ~ zona, data = indicadores_funcionales)
#grafiquito xq si:3
indicadores_long <- indicadores_funcionales %>%
select(zona, area_post, max_tasa_post, actividad_0_7, actividad_8_30, actividad_31_60) %>%
pivot_longer(
cols = -zona,
names_to = "indicador",
values_to = "valor"
)
ggplot(indicadores_long, aes(x = zona, y = valor, fill = zona)) +
geom_boxplot(alpha = 0.7, outlier.alpha = 0.4) +
facet_wrap(~ indicador, scales = "free_y") +
labs(
title = "Indicadores funcionales de secuencias sísmicas por zona",
x = NULL,
y = "Valor del indicador"
) +
theme_minimal() +
theme(legend.position = "none")
#veamos los outliers
ggplot(indicadores_long, aes(x = zona, y = log1p(valor), fill = zona)) +
geom_boxplot(alpha = 0.7, outlier.alpha = 0.4) +
facet_wrap(~ indicador, scales = "free_y") +
labs(
title = "Indicadores funcionales de secuencias sísmicas por zona",
subtitle = "Escala log(1+x)",
x = NULL,
y = "log(1 + valor)"
) +
theme_minimal() +
theme(legend.position = "none")
