grafico_perfil_tect_chile <- ggplot(
Chile_kde,
aes(x = longitude, y = depth)
) +
geom_hline(yintercept = c(30, 60), linetype = "dashed", linewidth = 0.4) +
geom_point(
aes(color = categoria_sismotectonica, size = Mw_hom),
alpha = 0.65
) +
scale_y_reverse(limits = c(180, 0)) +
coord_cartesian(xlim = c(-76, -69)) +
labs(
title = "Perfil sismotectónico longitud-profundidad en Chile central",
subtitle = paste0("Eventos con Mw_hom >= ", umbral_kde, ", período 2000-2025"),
x = "Longitud",
y = "Profundidad (km)",
color = "Clasificación\noperativa",
size = "Magnitud\nMw_hom",
caption = "Fuente: elaboración propia a partir de USGS Earthquake Catalog"
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold", size = 13),
plot.subtitle = element_text(size = 10),
legend.position = "right"
)
grafico_perfil_tect_chile
library(dplyr)
library(lubridate)
library(ggplot2)
library(tidyr)
library(zoo)
base_fda <- base_hom %>%
filter(
!is.na(Mw_hom),
Mw_hom >= 5.1,
!is.na(fecha_hora_utc),
!is.na(zona)
) %>%
mutate(
fecha = as.Date(fecha_hora_utc),
zona = case_when(
zona %in% c("chile", "Chile", "Chile central") ~ "Chile Central",
zona %in% c("mexico", "México", "Mexico", "México-Centroamérica") ~ "México-Centroamérica",
TRUE ~ as.character(zona)
)
)
eventos_fuertes <- base_fda %>%
filter(Mw_hom >= 6.0) %>%
arrange(zona, fecha_hora_utc) %>%
mutate(
id_evento_fuerte = row_number()
) %>%
select(id_evento_fuerte, zona, fecha_hora_utc, fecha, Mw_hom, latitude, longitude, depth, id)
eventos_fuertes %>%
count(zona)
#los separaremos en ventanas de 60 o 90 días para q las ventanas no se dupliquen demasiado
seleccionar_eventos_independientes <- function(df, separacion_min = 60) {
df <- df %>% arrange(fecha_hora_utc)
seleccionados <- list()
ultima_fecha <- as.POSIXct("1900-01-01", tz = "UTC")
for (i in seq_len(nrow(df))) {
fecha_actual <- df$fecha_hora_utc[i]
diferencia <- as.numeric(
difftime(fecha_actual, ultima_fecha, units = "days")
)
if (diferencia >= separacion_min) {
seleccionados[[length(seleccionados) + 1]] <- df[i, ]
ultima_fecha <- fecha_actual
}
}
bind_rows(seleccionados)
}
eventos_centrales <- eventos_fuertes %>%
group_by(zona) %>%
group_modify(~ seleccionar_eventos_independientes(.x, separacion_min = 60)) %>%
ungroup()
eventos_centrales %>%
count(zona)
ventana_pre <- 15
ventana_post <- 60
construir_ventana <- function(evento, base, pre = 15, post = 60) {
fecha_centro <- evento$fecha
zona_evento <- evento$zona
id_evento <- evento$id_evento_fuerte
base %>%
filter(
zona == zona_evento,
fecha >= fecha_centro - pre,
fecha <= fecha_centro + post
) %>%
mutate(
id_evento_fuerte = id_evento,
fecha_evento_fuerte = fecha_centro,
dia_relativo = as.integer(fecha - fecha_centro)
) %>%
count(id_evento_fuerte, zona, fecha_evento_fuerte, dia_relativo, name = "n_eventos")
}
ventanas_lista <- lapply(
split(eventos_centrales, eventos_centrales$id_evento_fuerte),
construir_ventana,
base = base_fda,
pre = ventana_pre,
post = ventana_post
)
ventanas_crudas <- bind_rows(ventanas_lista)
grilla_dias <- data.frame(
dia_relativo = seq(-ventana_pre, ventana_post, by = 1)
)
ventanas_completas <- eventos_centrales %>%
select(id_evento_fuerte, zona, fecha_evento_fuerte = fecha) %>%
crossing(grilla_dias) %>%
left_join(
ventanas_crudas,
by = c("id_evento_fuerte", "zona", "fecha_evento_fuerte", "dia_relativo")
) %>%
mutate(n_eventos = ifelse(is.na(n_eventos), 0, n_eventos))
matriz_curvas <- ventanas_completas %>%
select(id_evento_fuerte, dia_relativo, n_eventos) %>%
pivot_wider(
names_from = id_evento_fuerte,
values_from = n_eventos
) %>%
arrange(dia_relativo)
t <- matriz_curvas$dia_relativo
Y <- as.matrix(matriz_curvas[, -1])
basis_fd <- create.bspline.basis(
rangeval = range(t),
nbasis = 15
)
